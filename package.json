{
  "name": "nuxt-boilerplate",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "turbo run dev",
    "dev:web": "turbo run dev --filter=web",
    "dev:cms": "turbo run dev --filter=cms",
    "build": "turbo run build",
    "generate": "turbo run generate",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint:fix",
    "typecheck": "turbo run typecheck",
    "typegen": "turbo run typegen"
  },
  "devDependencies": {
    "turbo": "^2.11.8"
  },
  "engines": {
    "node": "24",
    "pnpm": "12"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "24"
    },
    "packageManager": {
      "name": "pnpm",
      "version": "12"
    }
  }
}
